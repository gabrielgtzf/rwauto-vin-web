---
import LayoutBase from '@layouts/LayoutBase.astro';
---

<LayoutBase>
  <div class="container" style="padding: 3rem 0;">
    <h1 class="section-title">Contáctanos</h1>
    <p style="text-align: center;">¿Dudas sobre la tokenización? Estamos aquí para ayudarte.</p>
    
    <div style="max-width: 600px; margin: 2rem auto;">
      <form data-netlify="true" name="contacto" method="POST" action="/?success=true">
        <input type="hidden" name="form-name" value="contacto" />
        
        <div class="form-group">
          <label>Nombre completo *</label>
          <input type="text" name="nombre" required />
        </div>
        <div class="form-group">
          <label>Correo electrónico *</label>
          <input type="email" name="email" required />
        </div>
        <div class="form-group">
          <label>Teléfono (opcional)</label>
          <input type="tel" name="telefono" />
        </div>
        <div class="form-group">
          <label>Asunto *</label>
          <select name="asunto" required>
            <option value="duda-tokenizacion">Duda sobre tokenización</option>
            <option value="problema-cuenta">Problema con mi cuenta</option>
            <option value="duda-precios">Duda sobre precios o pagos</option>
            <option value="reportar-vehiculo">Reportar un vehículo ya tokenizado</option>
            <option value="otro">Otro</option>
          </select>
        </div>
        <div class="form-group">
          <label>Mensaje *</label>
          <textarea name="mensaje" rows="5" required></textarea>
        </div>
        <div class="checkbox-group">
          <input type="checkbox" name="privacidad" required />
          <label>Acepto la política de privacidad y el tratamiento de mis datos para recibir respuesta.</label>
        </div>
        <button type="submit" class="btn-primary">Enviar mensaje</button>
      </form>
      
      <div style="margin-top: 2rem; text-align: center;">
        <p><strong>Correo directo:</strong> <a href="mailto:soporte@rwauto.vin">soporte@rwauto.vin</a></p>
        <p><strong>Horario de atención:</strong> Lunes a viernes, 9:00 a 18:00 (CDMX)</p>
      </div>
    </div>
  </div>
</LayoutBase>